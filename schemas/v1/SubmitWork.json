{
  "$defs": {
    "ItemKind": {
      "description": "The kind of work submitted.",
      "enum": [
        "ask",
        "incident"
      ],
      "title": "ItemKind",
      "type": "string"
    },
    "JsonValue": {},
    "Source": {
      "description": "Optional caller-supplied provenance.",
      "properties": {
        "app_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "App Id"
        },
        "channel": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Channel"
        },
        "client": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Client"
        }
      },
      "title": "Source",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "An idempotent work submission.",
  "properties": {
    "context": {
      "additionalProperties": {
        "$ref": "#/$defs/JsonValue"
      },
      "title": "Context",
      "type": "object"
    },
    "created_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Created At"
    },
    "id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9._:-]+$",
      "title": "Id",
      "type": "string"
    },
    "kind": {
      "$ref": "#/$defs/ItemKind",
      "default": "ask"
    },
    "repo": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Repo"
    },
    "source": {
      "anyOf": [
        {
          "$ref": "#/$defs/Source"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "text": {
      "maxLength": 4000,
      "minLength": 1,
      "title": "Text",
      "type": "string"
    }
  },
  "required": [
    "id",
    "text"
  ],
  "title": "SubmitWork",
  "type": "object"
}
